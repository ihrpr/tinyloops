{
  "name": "tinyloops",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:worker": "wrangler dev --host localhost:8787",
    "build": "vite build",
    "dev": "vite build --watch & wrangler dev --host localhost:8787",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint server web/src test",
    "check": "npm run lint && npm test",
    "stats": "sh scripts/stats.sh",
    "db:local": "wrangler d1 execute tinyloops --local --file=schema.sql",
    "db:remote": "wrangler d1 execute tinyloops --remote --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "vite": "^8.2.2",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
